
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a unique device-based user of the LifeOS application.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "passcodeEnabled": { "type": "boolean" },
        "totalPoints": { "type": "number", "default": 0 }
      },
      "required": ["id", "createdAt", "passcodeEnabled"]
    },
    "TaskProject": {
      "title": "TaskProject",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title"]
    },
    "TaskStage": {
      "title": "TaskStage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "title"]
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "projectId": { "type": "string" },
        "stageId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "expectedTime": { "type": "string", "description": "Expected time to complete" },
        "actualTime": { "type": "string", "description": "Actual time taken" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "projectId", "stageId", "title", "status", "priority"]
    },
    "Challenge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["fitness", "custom", "daily"] },
        "templateId": { "type": "string" },
        "targetValue": { "type": "number" },
        "durationValue": { "type": "number" },
        "durationType": { "type": "string", "enum": ["days", "minutes"] },
        "status": { "type": "string", "enum": ["active", "completed", "failed"] },
        "points": { "type": "number" },
        "startDate": { "type": "string", "format": "date-time" },
        "currentDay": { "type": "number" },
        "totalDays": { "type": "number" }
      },
      "required": ["userId", "title", "type", "status"]
    },
    "ChallengeResult": {
      "title": "ChallengeResult",
      "type": "object",
      "properties": {
        "challengeId": { "type": "string" },
        "userId": { "type": "string" },
        "result": { "type": "string", "enum": ["success", "fail"] },
        "value": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["challengeId", "userId", "result", "value", "date"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "user",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Stores core user data."
        }
      },
      {
        "path": "/users/{userId}/taskProjects/{projectId}",
        "definition": {
          "entityName": "taskProject",
          "schema": { "$ref": "#/backend/entities/TaskProject" },
          "description": "User project containers."
        }
      },
      {
        "path": "/users/{userId}/taskProjects/{projectId}/taskStages/{stageId}",
        "definition": {
          "entityName": "taskStage",
          "schema": { "$ref": "#/backend/entities/TaskStage" },
          "description": "Stages within a project."
        }
      },
      {
        "path": "/users/{userId}/taskProjects/{projectId}/taskStages/{stageId}/tasks/{taskId}",
        "definition": {
          "entityName": "task",
          "schema": { "$ref": "#/backend/entities/Task" },
          "description": "Tasks within a stage."
        }
      },
      {
        "path": "/users/{userId}/challenges/{challengeId}",
        "definition": {
          "entityName": "challenge",
          "schema": { "$ref": "#/backend/entities/Challenge" },
          "description": "User challenges."
        }
      },
      {
        "path": "/users/{userId}/challengeResults/{resultId}",
        "definition": {
          "entityName": "challengeResult",
          "schema": { "$ref": "#/backend/entities/ChallengeResult" },
          "description": "Results of challenge attempts."
        }
      }
    ]
  }
}
