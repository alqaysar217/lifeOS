
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a unique device-based user of the LifeOS application.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "passcodeEnabled": { "type": "boolean" }
      },
      "required": ["id", "createdAt", "passcodeEnabled"]
    },
    "Habit": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Habit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "streak": { "type": "number" },
        "lastCompleted": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "title", "streak", "lastCompleted", "status"]
    },
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "project": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "status", "project"]
    },
    "Challenge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "currentDay": { "type": "number" },
        "totalDays": { "type": "number" }
      },
      "required": ["id", "userId", "title", "currentDay", "totalDays"]
    },
    "FitnessRecord": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FitnessRecord",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "steps": { "type": "number" },
        "distance": { "type": "number" },
        "reps": { "type": "number" },
        "durationSeconds": { "type": "number" }
      },
      "required": ["id", "userId", "type", "date", "durationSeconds"]
    },
    "GymDay": {
      "title": "GymDay",
      "type": "object",
      "properties": {
        "dayName": { "type": "string", "enum": ["السبت", "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dayName"]
    },
    "GymMuscle": {
      "title": "GymMuscle",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "GymExercise": {
      "title": "GymExercise",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sets": { "type": "number" },
        "reps": { "type": "string" }
      },
      "required": ["name", "sets", "reps"]
    },
    "FinanceTransaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FinanceTransaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "category", "date"]
    },
    "StudyProgress": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StudyProgress",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "progress": { "type": "number" }
      },
      "required": ["id", "userId", "subject", "progress"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "user",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Stores core user data."
        }
      },
      {
        "path": "/users/{userId}/gymDays/{dayId}",
        "definition": {
          "entityName": "gymDay",
          "schema": { "$ref": "#/backend/entities/GymDay" },
          "description": "Days in the workout plan."
        }
      },
      {
        "path": "/users/{userId}/gymDays/{dayId}/muscles/{muscleId}",
        "definition": {
          "entityName": "gymMuscle",
          "schema": { "$ref": "#/backend/entities/GymMuscle" },
          "description": "Muscle groups per day."
        }
      },
      {
        "path": "/users/{userId}/gymDays/{dayId}/muscles/{muscleId}/exercises/{exerciseId}",
        "definition": {
          "entityName": "gymExercise",
          "schema": { "$ref": "#/backend/entities/GymExercise" },
          "description": "Exercises per muscle group."
        }
      }
    ]
  }
}
